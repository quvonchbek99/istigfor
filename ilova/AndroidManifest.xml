<?xml version="1.0" encoding="utf-8"?>
<!-- Ilovaning "pasporti": nomi, belgisi, ruxsatlari va ochiladigan oynasi -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="uz.kuvonch.istigfor"
    android:versionCode="3"
    android:versionName="1.2">

    <!-- Android 5.0 dan boshlab ishlaydi -->
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <!-- Internet faqat shriftlar uchun kerak; ilova internetsiz ham ishlaydi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Har bosishda telefonni titratish uchun -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Ovoz bilan sanash: «Astag‘firulloh» deganingizni eshitish uchun -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ da telefonning nutqni tanish xizmatini ko‘ra olish uchun -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="@string/nomi"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Mavzu"
        android:allowBackup="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
